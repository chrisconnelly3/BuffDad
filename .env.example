# BuffDad configuration. For LOCAL dev you don't need any of this —
# the tokens fall back to dev-dad / dev-coach and push is simply disabled
# without VAPID keys. These matter for a real deployment.

# The two secret URL tokens. Set to long random strings, e.g.:
#   node -e "console.log(crypto.randomUUID().replace(/-/g,''))"
# The app is reachable ONLY at /d/<DAD_TOKEN> and /coach/<COACH_TOKEN>;
# every other path returns the 404 "members only" page.
# In production the server refuses to boot if these are unset or left as the dev defaults.
DAD_TOKEN=dev-dad
COACH_TOKEN=dev-coach

# Web Push (VAPID). Generate a keypair once:  npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact "subject" the push service can reach you at. Optional.
VAPID_SUBJECT=mailto:you@example.com

# Server
PORT=8787
DB_PATH=./data.db
